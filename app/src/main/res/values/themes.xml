<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CleanArchitectureShowcase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/background_beige</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary" />
        <item name="colorSecondaryVariant" />
        <item name="colorOnSecondary" />
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/background_beige</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.CleanArchitectureShowcase" parent="Base.Theme.CleanArchitectureShowcase" />

    <style name="CustomCheckbox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/checkbox_background</item>
        <item name="android:gravity">right</item>
        <item name="android:padding">10dp</item>
    </style>
</resources>